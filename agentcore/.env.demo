# =============================================================================
# AgentCore — LOCAL DEMO configuration (no Azure)
# Copy to `.env` (start-demo.ps1 does this automatically if .env is missing).
# Everything Azure-related is left empty so the platform runs fully local:
#   - no Key Vault (secrets come from this file)
#   - no Entra ID SSO (local username/password login)
#   - no Azure Managed Redis (plain local Redis, no Entra token auth)
#   - no Azure Blob storage (local file storage)
# =============================================================================

# ---- Network ----------------------------------------------------------------
HOST_IP=127.0.0.1
LOCALHOST_HOST=127.0.0.1
BACKEND_PORT=7860
FRONTEND_PORT=3000
BACKEND_URL=http://127.0.0.1:7860
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database (project-local PostgreSQL started by start-demo.ps1) ---------
# To use another PostgreSQL server instead, change this URL.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/agentcore

# ---- Cache: plain local Redis (no Entra ID). Falls back to in-memory if down.
CACHE_TYPE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_SSL=false
REDIS_CLUSTER_ENABLED=false
REDIS_CACHE_EXPIRE=3600
REDIS_ENTRA_SCOPE=
REDIS_PASSWORD=
CACHE_STRICT_STARTUP=false

# ---- Local admin login (created/refreshed on every backend start) ----------
AGENTCORE_SUPERUSER=admin@demo.local
AGENTCORE_SUPERUSER_PASSWORD=Demo@12345
# Lets users reset passwords from the UI without SMTP.
AGENTCORE_ALLOW_DIRECT_PASSWORD_RESET=true

# ---- Azure: intentionally disabled -----------------------------------------
AGENTCORE_KEY_VAULT_URL=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
STORAGE_TYPE=local

# ---- Telemetry endpoint placeholder (telemetry is disabled via DO_NOT_TRACK) -
LOCALHOST_TELEMETRY_BASE_URL=

# ---- Optional subsystems off for the demo ----------------------------------
LTM_ENABLED=false
DO_NOT_TRACK=true
AGENTCORE_LOG_LEVEL=INFO

# ---- Model microservice (LLM & embeddings) ----------------------------------
# Started by start-demo.ps1 on port 8001; the backend proxies model registry calls
# and chat/embedding requests to it. MODEL_SERVICE_API_KEY is the shared secret
# between backend and service (both read this same variable).
MODEL_SERVICE_URL=http://127.0.0.1:8001
MODEL_SERVICE_API_KEY=demo-model-service-key-change-me
MODEL_SERVICE_HOST=127.0.0.1
MODEL_SERVICE_PORT=8001
MODEL_SERVICE_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/agentcore
# Fernet key used to encrypt provider API keys in the local secret store
# (src/services/model-service/.secrets/). Rotate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_SERVICE_ENCRYPTION_KEY=o1Bu6vJcj2Enj9DOjeKi-1g77qyeiFhOtKQZDedqmjc=
MODEL_SERVICE_KEY_VAULT_URL=
MODEL_SERVICE_RATE_LIMIT_ENABLED=true
MODEL_SERVICE_RATE_LIMIT_FAIL_MODE=open
MODEL_SERVICE_LOG_LEVEL=info
# Other microservices (MCP, guardrails, pinecone, graph-rag) are not part of the demo yet.
